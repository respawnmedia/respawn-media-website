{
  "framework": null,
  "rewrites": [
    {
      "source": "/api/careers/config",
      "destination": "https://respawn-media-website.vercel.app/api/careers/config"
    },
    {
      "source": "/api/careers/apply",
      "destination": "https://respawn-media-website.vercel.app/api/careers/apply"
    },
    {
      "source": "/careers/apply/:slug",
      "destination": "/careers/application.html"
    },
    {
      "source": "/careers/thanks",
      "destination": "/careers/application.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers/index.html"
    },
    {
      "source": "/portfolio/:category",
      "destination": "/portfolio/:category/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/careers",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/careers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "installCommand": "npm --prefix prototypes/respawn-motion ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
